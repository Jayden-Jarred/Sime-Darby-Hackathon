# Python
__pycache__/
*.pyc

# Virtual environments
venv/
.venv/
env/

# Secrets: keys live in the environment or a local .env, never in git
.env
.env.*

# Logs
*.log

# Generated by app.py on first run (from the installed plotly package)
static/plotly.min.js

# The demo database: built by generate_dummy_data.py (or the app's first run),
# and changed by every practice run, so each computer keeps its own.
data/right_fit.db
data/right_fit.db-journal
# Any other database file, and SQLite's side files if WAL mode is ever turned on
*.db
*.sqlite3
*-wal
*-shm
# CSV copies from `python db.py export`
data/export/

# Local tool state
.impeccable/
.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db
